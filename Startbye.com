<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>StartBye.Id – Gaming Hub</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&family=Rajdhani:wght@500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#070914;--card:#0e1230;--text:#e8ecff;--muted:#8d97c9;--cyan:#f2f5ff;--purple:#9aa3cc;--red:#ff2d55;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
:root{color-scheme:dark}
@media (prefers-color-scheme:light){:root:not([data-theme="dark"]){--bg:#070914;--card:#0e1230;--text:#e8ecff}}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;min-height:100vh;background:radial-gradient(circle at 20% 0%,#1a1050 0,transparent 45%),radial-gradient(circle at 90% 30%,#06324a 0,transparent 40%),var(--bg);color:var(--text);font-family:'Rajdhani','Segoe UI',sans-serif;font-size:18px;display:flex;flex-direction:column}
body::after{content:"";position:fixed;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(255,255,255,.025) 0 1px,transparent 1px 4px)}
main{flex:1;width:100%;max-width:760px;margin:0 auto;padding:56px 20px 32px}
.logo{display:block;width:min(70vw,280px);aspect-ratio:1;border-radius:50%;margin:0 auto 28px;box-shadow:0 0 40px rgba(235,240,255,.35),0 0 90px rgba(154,163,204,.35);animation:float 4s ease-in-out 3.5s infinite}
.hero{text-align:center}
.thumb{flex:none;width:64px;height:64px;border-radius:50%;box-shadow:0 0 14px rgba(235,240,255,.5)}
.yt{display:inline-flex;align-items:center;gap:6px}.yt svg{width:18px;height:18px;fill:var(--red)}
h1{font-family:'Orbitron','Arial Black',sans-serif;font-weight:900;font-size:clamp(2rem,9vw,4rem);margin:0;line-height:1.05;color:var(--cyan);text-shadow:0 0 8px var(--cyan),0 0 28px rgba(235,240,255,.6),0 0 60px rgba(154,163,204,.6);animation:flick 3s 2.9s 1 both}
h1 span{color:var(--purple);text-shadow:0 0 8px var(--purple),0 0 28px rgba(154,163,204,.7)}
.tag{color:var(--muted);margin:14px 0 44px;font-size:1.15rem}
h2{font-family:'Orbitron',sans-serif;font-size:1rem;margin:0 0 16px;color:var(--text)}
.list{display:grid;gap:16px}
.card{position:relative;overflow:hidden;display:flex;align-items:center;gap:16px;padding:18px;text-decoration:none;color:inherit;background:var(--card);border:1px solid rgba(235,240,255,.35);border-radius:14px;box-shadow:0 0 0 rgba(235,240,255,0);transition:transform .2s,box-shadow .2s,border-color .2s}
.card:hover,.card:focus-visible{transform:translateY(-3px);border-color:var(--cyan);box-shadow:0 0 22px rgba(235,240,255,.45),inset 0 0 18px rgba(154,163,204,.2);outline:none}
.card:focus-visible{outline:2px solid var(--purple);outline-offset:3px}
.icon{flex:none;width:56px;height:56px;border-radius:12px;background:var(--red);display:grid;place-items:center;box-shadow:0 0 18px rgba(255,45,85,.6)}
.icon svg{width:28px;height:28px;fill:#fff}
.info{flex:1;min-width:0}
.name{font-family:'Orbitron',sans-serif;font-size:1.15rem;margin:0}
.meta{color:var(--muted);margin:4px 0 0}
.btn{flex:none;padding:10px 16px;border-radius:10px;font-weight:600;color:#07080f;background:linear-gradient(90deg,var(--cyan),var(--purple));box-shadow:0 0 14px rgba(235,240,255,.5)}
footer{text-align:center;color:var(--muted);padding:24px 20px;font-size:.95rem}
@keyframes flick{0%,18%,22%,60%{opacity:1}20%,24%{opacity:.35}}
#boot{position:fixed;inset:0;z-index:50;background:#000;display:grid;place-content:center;gap:18px;text-align:center;font-family:'Orbitron',sans-serif;animation:bootout .5s 2.6s forwards}
#boot p{margin:0;letter-spacing:.2em;font-size:.85rem;color:var(--muted)}
.bar{width:min(70vw,280px);height:12px;border:1px solid var(--cyan);padding:2px;margin:0 auto}
.bar i{display:block;height:100%;width:0;background:var(--cyan);box-shadow:0 0 10px var(--cyan);animation:fill 1.7s steps(12) .2s forwards}
.start{opacity:0;color:var(--cyan)!important;animation:ps .5s steps(1) 1.9s 2}
.hero{animation:heroIn .9s 2.6s both}
@keyframes bootout{to{opacity:0;visibility:hidden}}
@keyframes fill{to{width:100%}}
@keyframes ps{0%{opacity:1}50%{opacity:0}}
@keyframes heroIn{from{opacity:0;transform:scale(.7);filter:blur(12px)}to{opacity:1;transform:none;filter:none}}
.arcade{margin-top:48px;border:1px solid rgba(235,240,255,.35);border-radius:14px;background:#04050c;overflow:hidden;box-shadow:0 0 24px rgba(235,240,255,.15)}
.hud{display:flex;justify-content:space-between;gap:8px;padding:10px 14px;font-family:'Orbitron',sans-serif;font-size:.7rem;color:var(--muted)}
.hud b{color:var(--cyan)}
.blink{color:var(--red);animation:ps 1s steps(1) infinite}
#arc{display:block;width:100%;height:190px}
@keyframes float{0%,100%{transform:translateY(0);box-shadow:0 0 40px rgba(235,240,255,.3),0 0 80px rgba(154,163,204,.3)}50%{transform:translateY(-10px);box-shadow:0 0 60px rgba(235,240,255,.55),0 0 120px rgba(154,163,204,.5)}}
.card::after{content:"";position:absolute;top:0;left:-60%;width:40%;height:100%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.28),transparent);transform:skewX(-20deg);pointer-events:none;animation:shine 4s 4s infinite}
@keyframes shine{0%{left:-60%}35%,100%{left:140%}}
.spark{position:fixed;width:6px;height:6px;margin:-3px 0 0 -3px;border-radius:50%;pointer-events:none;z-index:40;background:#fff;box-shadow:0 0 8px #fff,0 0 16px var(--purple);animation:spark .6s ease-out forwards}
@keyframes spark{to{opacity:0;transform:translate(var(--dx),var(--dy)) scale(0)}}
#bg{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
main,footer{position:relative;z-index:1}
.sup{margin-top:40px!important}
.insert{display:flex;align-items:center;justify-content:center;gap:12px;padding:12px 14px;font-family:'Orbitron',sans-serif;font-weight:700;font-size:clamp(.7rem,3.2vw,.95rem);letter-spacing:.06em;text-align:center;color:#ffd75e;text-shadow:0 0 8px #ffb020;border:2px dashed #ffd75e;border-radius:10px;background:rgba(14,18,48,.85);animation:ins 1.2s ease-in-out infinite}
.coin{flex:none;width:26px;height:26px;border-radius:50%;background:#ffd75e;color:#4a3300;display:grid;place-items:center;font-size:.8rem;box-shadow:0 0 12px #ffb020;animation:cflip 1.6s linear infinite}
@keyframes ins{50%{border-color:rgba(255,215,94,.25)}}
@keyframes cflip{50%{transform:scaleX(.15)}}
@media (prefers-reduced-motion:reduce){#boot{display:none!important}}
@media (max-width:520px){.card{flex-wrap:wrap}.btn{width:100%;text-align:center}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<canvas id="bg" aria-hidden="true"></canvas>
<div id="boot" aria-hidden="true"><p>LOADING STARTBYE.ID</p><div class="bar"><i></i></div><p class="start">PRESS START</p></div>
<main>
  <div class="hero"><img class="logo" src="data:image/jpeg;base64,
